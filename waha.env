# WAHA Core Environment Configuration

# API Configuration
WAHA_API_ENABLED=true
WAHA_API_PREFIX=/api
WAHA_API_KEY=

# Webhook Configuration (optional)
WAHA_WEBHOOK_ENABLED=false
WAHA_WEBHOOK_URL=
WAHA_WEBHOOK_SECRET=

# WhatsApp Engine Configuration
WHATSAPP_DEFAULT_ENGINE=NOWEB
WHATSAPP_START_ENGINE=true

# Logging Configuration
WAHA_LOG_LEVEL=INFO

# Session Configuration
WAHA_SESSIONS_PATH=/app/sessions
WAHA_SAVE_SESSSIONS=true

# Media Configuration
WAHA_MEDIA_PATH=/app/storage/media
WAHA_SAVE_MEDIA=true

# Browser Configuration (for WEB engine)
WAHA_BROWSER_TIMEOUT=60000
WAHA_BROWSER_HEADLESS=true

# Server Configuration
PORT=3000